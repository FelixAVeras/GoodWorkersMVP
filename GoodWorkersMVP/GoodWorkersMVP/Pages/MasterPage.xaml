<?xml version="1.0" encoding="utf-8" ?>
<MasterDetailPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:page="clr-namespace:GoodWorkersMVP.Pages"
                  x:Class="GoodWorkersMVP.Pages.MasterPage">
    <MasterDetailPage.Master>
        <page:MenuPage></page:MenuPage>
    </MasterDetailPage.Master>
    <MasterDetailPage.Detail>
        <NavigationPage x:Name="Navigator"
                        BarTextColor="#fff"
                        BarBackgroundColor="#253544">
            <x:Arguments>
                <page:OcupationPage></page:OcupationPage>
            </x:Arguments>
        </NavigationPage>
    </MasterDetailPage.Detail>
</MasterDetailPage>