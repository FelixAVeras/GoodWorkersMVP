<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoodWorkersMVP.Pages.OcupationPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}"
             Title="GoodWorkersMVP">
    <ContentPage.Content>
        <StackLayout BindingContext="{Binding Ocupations}">
            <ListView ItemsSource="{Binding Ocupations}" HasUnevenRows="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                            Command="{Binding SelectOcupationCommand}">
                                    </TapGestureRecognizer>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding OcupationName}"></Label>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>