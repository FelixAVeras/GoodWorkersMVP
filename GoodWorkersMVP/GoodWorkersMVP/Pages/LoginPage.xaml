<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoodWorkersMVP.Pages.LoginPage"
             xmlns:i18n="clr-namespace:GoodWorkersMVP.Helpers"
             BindingContext="{Binding Main, Source={StaticResource Locator}}"
             Title="{i18n:Translate LoginTitlePage}">
    <ContentPage.Content>
        <ScrollView BindingContext="{Binding Login}" Padding="8">
            <StackLayout>

                <Image Source="human"
                        WidthRequest="128"
                        HorizontalOptions="Center"
                        Aspect="AspectFit"></Image>

                <Label FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="CenterAndExpand"
                   Text="GoodWorkersMVP"></Label>


                <Entry Keyboard="Email"
                   Placeholder="{i18n:Translate EmailPlaceholder}"
                   Margin="0,13,0,13"
                   Text="{Binding Email, Mode=TwoWay}"></Entry>

                <Entry Placeholder="{i18n:Translate PasswordPlaceholder}"
                       Margin="0,0,0,13"
                       IsPassword="True"
                       Text="{Binding Password, Mode=TwoWay}"></Entry>

                <StackLayout Orientation="Horizontal">
                    <Label Text="{i18n:Translate RememberMyDataLabel}"
                           VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"></Label>
                    <Switch IsToggled="{Binding IsRemember, Mode=TwoWay}"
                            HorizontalOptions="End">
                    </Switch>
                </StackLayout>

                <Label Text="{i18n:Translate ForgetPasswordLabel}"
                       HorizontalOptions="CenterAndExpand"
                       VerticalOptions="Center"
                       Margin="0,0,0,17"
                       FontAttributes="Bold"
                       TextColor="#18bc9c">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RecoverPasswordCommand}"></TapGestureRecognizer>
                    </Label.GestureRecognizers>
                </Label>

                <ActivityIndicator Color="#18bc9c"
                                   IsRunning="{Binding IsRunning, Mode=TwoWay}"></ActivityIndicator>


                <StackLayout Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Text="{i18n:Translate BtnEnterLabel}" 
                        Command="{Binding LoginCommand}" 
                        BackgroundColor="#253544"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        IsEnabled="{Binding IsEnable, Mode=TwoWay}"></Button>

                    <Button Text="{i18n:Translate BtnRegisterLabel}"
                        BackgroundColor="#95a5a6"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        Command="{Binding RegisterCommand}" 
                        IsEnabled="{Binding IsEnable, Mode=TwoWay}"></Button>

                </StackLayout>
            </StackLayout>
        </ScrollView>
        
    </ContentPage.Content>
</ContentPage>