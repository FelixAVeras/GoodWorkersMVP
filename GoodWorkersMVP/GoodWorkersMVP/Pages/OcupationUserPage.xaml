<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoodWorkersMVP.Pages.OcupationUserPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}"
             Title="Ocupacion Detalle">
    <ContentPage.Content>
        <ScrollView BindingContext="{Binding OcupationUser}">
            <StackLayout>
                <Label FontSize="Large" 
                       FontAttributes="Bold" 
                       Text="{Binding Ocupation.OcupationName}"></Label>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>