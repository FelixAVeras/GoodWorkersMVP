<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:infra="clr-namespace:GoodWorkersMVP.Infrastructure"
             x:Class="GoodWorkersMVP.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Locator -->
            <infra:InstanceLocator x:Key="Locator" />

            <!-- Parameters -->
            <x:String x:Key="UrlAPI">https://aqueous-beach-68994-3f94c7a633d0.herokuapp.com</x:String>
            <x:String x:Key="Prefix">/api</x:String>
            <x:String x:Key="RegisterEndPoint">/register</x:String>
            <x:String x:Key="loginEndPoint">/login</x:String>
            <x:String x:Key="ocupationEndPoint">/ocupations</x:String>
            <x:String x:Key="documentTypeEndPoint">/documentTypes</x:String>
            <x:String x:Key="userTypeEndPoint">/userTypes</x:String>
            <x:String x:Key="userEndPoint">/users</x:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>